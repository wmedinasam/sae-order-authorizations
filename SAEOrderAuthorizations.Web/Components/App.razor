@using SAEOrderAuthorizations.Web.Services
@inject MarcaService MarcaService

<!DOCTYPE html>
<html lang="es" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="brand/web/brand-tokens.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SAEOrderAuthorizations.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="@_marca.FaviconTipo" href="@_marca.FaviconUrl" />
    <HeadOutlet />
</head>

<body class="wis-brand">
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private MarcaInfo _marca = null!;

    protected override async Task OnInitializedAsync() => _marca = await MarcaService.ObtenerAsync();
}
