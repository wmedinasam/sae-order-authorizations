@page "/configuracion"
@attribute [Authorize(Policy = "Administrador")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SAEOrderAuthorizations.Web.Components.Configuracion
@using SAEOrderAuthorizations.Web.Services
@inject ConfiguracionService ConfigSvc

<TituloPagina Texto="Configuración" />

<section class="wis-container">
    <PaginaEncabezado Titulo="Configuración" Subtitulo="Parámetros del sistema, marca y correo de autorización.">
        @if (pestana == "general")
        {
            <IconButton Icono="plus" Variante="agregar" Texto="Nueva" MostrarTexto="true" OnClick="Nueva" />
        }
    </PaginaEncabezado>

    <div class="wis-tabs wis-mb-5" role="tablist" aria-label="Secciones de configuración" @onkeydown="TeclaPestana">
        @foreach (var (id, titulo) in Pestanas)
        {
            <button type="button" role="tab" id="tab-@id" aria-controls="panel-@id" aria-selected="@(pestana == id ? "true" : "false")"
                    tabindex="@(pestana == id ? 0 : -1)" class="wis-tab @(pestana == id ? "activa" : "")"
                    @onclick="() => pestana = id">@titulo</button>
        }
    </div>

    <div role="tabpanel" id="panel-@pestana" aria-labelledby="tab-@pestana">
    @if (pestana == "general")
    {
    <div class="wis-toolbar">
        <label class="wis-check">
            <input type="checkbox" @bind="mostrarInactivas" @bind:after="CargarAsync" /> Mostrar inactivas
        </label>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="@(exito ? "wis-alert-ok" : "wis-alert-error") wis-mb-5" role="@(exito ? "status" : "alert")">@mensaje</div>
    }

    <div class="wis-card wis-seccion-tabla">
        <div class="wis-tabla-wrap">
            <table class="wis-table wis-table--cards">
                <thead>
                    <tr>
                        <th>Clave</th>
                        <th>Valor</th>
                        <th>Estado</th>
                        <th><span class="wis-sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in items)
                    {
                        <tr>
                            <td data-label="Clave">@c.Key</td>
                            <td data-label="Valor">@(c.Sensible ? "••••••" : c.Valor)</td>
                            <td data-label="Estado"><EstadoBadge Tipo="@(c.Estado ? "activo" : "inactivo")" Texto="@(c.Estado ? "Activa" : "Inactiva")" /></td>
                            <td>
                                <div class="wis-acciones">
                                    <IconButton Icono="pencil" Variante="editar" Texto="Editar" OnClick="() => Editar(c)" />
                                    @if (c.Estado)
                                    {
                                        <IconButton Icono="ban" Variante="inactivar" Texto="Inactivar" OnClick="() => CambiarEstado(c)" />
                                    }
                                    else
                                    {
                                        <IconButton Icono="undo" Variante="reactivar" Texto="Reactivar" OnClick="() => CambiarEstado(c)" />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (items.Count == 0 && string.IsNullOrEmpty(mensaje))
                    {
                        <EstadoVacio Columnas="4" Mensaje="No hay configuraciones para mostrar." />
                    }
                </tbody>
            </table>
        </div>
    </div>

    }
    else if (pestana == "marca")
    {
        <MarcaSeccion />
    }
    else
    {
        <CorreoSeccion />
    }
    </div>
</section>

@if (modalAbierto)
{
    <ConfiguracionModal Item="seleccionada" Usuario="usuario" OnCerrar="Cerrar" OnGuardado="Guardado" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ClaimsPrincipal usuario = new();
    private List<ConfiguracionItem> items = new();
    private static readonly (string Id, string Titulo)[] Pestanas =
    [
        ("general", "General"),
        ("marca", "Marca"),
        ("correo", "Correo")
    ];

    private string pestana = "general";
    private bool mostrarInactivas;
    private bool modalAbierto;
    private ConfiguracionItem? seleccionada;
    private string? mensaje;
    private bool exito;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) usuario = (await AuthState).User;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        try
        {
            items = await ConfigSvc.ListarAsync(usuario, mostrarInactivas);
        }
        catch (Exception ex)
        {
            items = new();
            Mostrar(false, $"No se pudo cargar la configuración: {ex.Message}");
        }
    }

    private void TeclaPestana(KeyboardEventArgs e)
    {
        var delta = e.Key switch { "ArrowRight" => 1, "ArrowLeft" => -1, _ => 0 };
        if (delta == 0) return;
        var i = Array.FindIndex(Pestanas, p => p.Id == pestana);
        pestana = Pestanas[(i + delta + Pestanas.Length) % Pestanas.Length].Id;
    }

    private void Mostrar(bool ok, string texto)
    {
        exito = ok;
        mensaje = texto;
    }

    private void Nueva()
    {
        seleccionada = null;
        modalAbierto = true;
    }

    private void Editar(ConfiguracionItem c)
    {
        seleccionada = c;
        modalAbierto = true;
    }

    private void Cerrar() => modalAbierto = false;

    private async Task Guardado(string resultado)
    {
        modalAbierto = false;
        await CargarAsync();
        Mostrar(true, resultado);
    }

    private async Task CambiarEstado(ConfiguracionItem c)
    {
        try
        {
            var r = await ConfigSvc.CambiarEstadoAsync(usuario, c.Id, !c.Estado);
            await CargarAsync();
            Mostrar(r.Exito, r.Mensaje);
        }
        catch (Exception ex)
        {
            Mostrar(false, $"No se pudo cambiar el estado: {ex.Message}");
        }
    }
}
