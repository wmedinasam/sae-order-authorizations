@page "/ordenes"
@attribute [Authorize]
@rendermode InteractiveServer
@using SAEOrderAuthorizations.Web.Components.Orders
@using SAEOrderAuthorizations.Web.Data.Entities
@using SAEOrderAuthorizations.Web.Services
@inject OrdenesService OrdenesSvc
@inject OrdenesMonitor Monitor
@implements IDisposable

<TituloPagina Texto="Órdenes" />

<section class="wis-container">
    <PaginaEncabezado Titulo="Órdenes" Subtitulo="Consulta y autoriza las órdenes de compra de SAE." />

    <div class="wis-toolbar wis-mb-5">
            <div>
                <label class="wis-field-label" for="empresa">Empresa</label>
                <select id="empresa" class="wis-input" @bind="empresaId" @bind:after="CargarAsync">
                    @foreach (var e in empresas)
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </select>
            </div>
            <div>
                <label class="wis-field-label" for="estado">Estado</label>
                <select id="estado" class="wis-input" @bind="estado" @bind:after="CargarAsync">
                    <option value="P">Pendientes</option>
                    <option value="O">Autorizadas</option>
                    <option value="R">Rechazadas</option>
                </select>
            </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="@(mensajeOk ? "wis-alert-ok" : "wis-alert-error") wis-mb-5" role="@(mensajeOk ? "status" : "alert")">@mensaje</div>
    }
    @if (!string.IsNullOrEmpty(aviso))
    {
        <p class="wis-muted wis-mb-5" aria-live="polite">@aviso</p>
    }

    <div class="wis-card wis-seccion-tabla">
        <div class="wis-tabla-wrap">
            <table class="wis-table wis-table--cards">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Proveedor</th>
                        <th>Fecha</th>
                        <th class="wis-num">Total</th>
                        <th>Observaciones</th>
                        <th><span class="wis-sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <tr class="wis-skeleton" aria-hidden="true">
                                @for (var c = 0; c < 6; c++)
                                {
                                    <td><span></span></td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                    @foreach (var o in ordenesPagina)
                    {
                        <tr class="wis-row-link" @onclick="() => Abrir(o)">
                            <td data-label="Documento">
                                @o.IdOrder.Trim()
                                @if (o.ReservadaPor is not null)
                                {
                                    <EstadoBadge Texto="@($"En revisión por {o.ReservadaPor}")" Tipo="pendiente" />
                                }
                            </td>
                            <td data-label="Proveedor">@o.Vendor?.Trim()</td>
                            <td data-label="Fecha">@o.OrdDate.ToString("d")</td>
                            <td data-label="Total" class="wis-num">@o.Total.ToString("N2")</td>
                            <td data-label="Observaciones">@o.Observations?.Trim()</td>
                            <td><div class="wis-acciones"><IconButton @ref="botonesConsulta[o.IdOrder.Trim()]" Icono="eye" Variante="ver" Texto="Consultar" OnClick="() => Abrir(o)" /></div></td>
                        </tr>
                    }
                    @if (ordenes.Count == 0 && string.IsNullOrEmpty(mensaje))
                    {
                        <EstadoVacio Columnas="6" Mensaje="No hay órdenes en este estado." />
                    }
                    }
                </tbody>
            </table>
        </div>
        @if (ordenes.Count > 0)
        {
            <nav class="wis-paginacion" aria-label="Paginación de órdenes">
                <span class="wis-muted" aria-live="polite">Mostrando @(((pagina - 1) * TamanoPagina) + 1)–@(Math.Min(pagina * TamanoPagina, ordenes.Count)) de @ordenes.Count</span>
                <div class="wis-acciones">
                    <button type="button" class="wis-button wis-button--secondary" disabled="@(pagina <= 1)" @onclick="() => IrAPagina(pagina - 1)">Anterior</button>
                    <span class="wis-muted">Página @pagina de @TotalPaginas</span>
                    <button type="button" class="wis-button wis-button--secondary" disabled="@(pagina >= TotalPaginas)" @onclick="() => IrAPagina(pagina + 1)">Siguiente</button>
                </div>
            </nav>
        }
    </div>
</section>

@if (seleccionada is not null && empresaSeleccionada is not null)
{
    <OrdenModal Orden="seleccionada" Empresa="empresaSeleccionada" EsAprobador="esAprobador"
                OnCerrar="Cerrar" OnProcesada="OrdenProcesada" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Empresa> empresas = new();
    private List<OrdenSae> ordenes = new();
    private const int TamanoPagina = 10;
    private int pagina = 1;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(ordenes.Count / (double)TamanoPagina));
    private IEnumerable<OrdenSae> ordenesPagina => ordenes.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina);
    private int empresaId;
    private string estado = "P";
    private string? mensaje;
    private bool mensajeOk;
    private bool cargando = true;
    private bool esAprobador;
    private string? aviso;
    private OrdenSae? seleccionada;
    private readonly Dictionary<string, IconButton?> botonesConsulta = new();

    private Empresa? empresaSeleccionada => empresas.FirstOrDefault(e => e.Id == empresaId);

    protected override async Task OnInitializedAsync()
    {
        var usuario = AuthState is null ? null : (await AuthState).User;
        if (usuario is null) return;

        esAprobador = usuario.IsInRole("Aprobador");
        var rolId = int.Parse(usuario.FindFirst("RolId")?.Value ?? "0");
        empresas = await OrdenesSvc.EmpresasDelRolAsync(rolId);
        empresaId = empresas.FirstOrDefault()?.Id ?? 0;
        Monitor.Refrescar += AlRefrescar;
        await CargarAsync();
    }

    public void Dispose() => Monitor.Refrescar -= AlRefrescar;

    // Llega desde el monitor (otro hilo): se vuelve al circuito con InvokeAsync.
    private Task AlRefrescar() => InvokeAsync(async () =>
    {
        if (!cargando && empresaSeleccionada is not null)
            await RecargarSilenciosoAsync();
    });

    // Recarga sin skeleton ni reinicio de página: no interrumpe al aprobador que está leyendo.
    private async Task RecargarSilenciosoAsync()
    {
        var paginaActual = pagina;
        try
        {
            ordenes = await OrdenesSvc.ListarAsync(empresaSeleccionada!, estado);
            pagina = Math.Clamp(paginaActual, 1, TotalPaginas);
            aviso = $"Lista actualizada a las {DateTime.Now:HH:mm}.";
        }
        catch (Exception ex)
        {
            aviso = $"No se pudo actualizar la lista: {ex.Message}";
        }
        // InvokeAsync no vuelve a pintar por sí solo; sin esto la lista cambia en memoria pero no en pantalla.
        StateHasChanged();
    }

    private async Task CargarAsync()
    {
        mensaje = null;
        mensajeOk = false;
        aviso = null;
        ordenes = new();
        pagina = 1;
        if (empresaSeleccionada is null)
        {
            mensaje = "Tu rol no tiene empresas asignadas.";
            cargando = false;
            return;
        }

        cargando = true;

        try
        {
            ordenes = await OrdenesSvc.ListarAsync(empresaSeleccionada, estado);
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudieron cargar las órdenes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrAPagina(int nueva)
    {
        pagina = Math.Clamp(nueva, 1, TotalPaginas);
    }

    private void Abrir(OrdenSae orden) => seleccionada = orden;

    private async Task Cerrar()
    {
        var id = seleccionada?.IdOrder.Trim();
        seleccionada = null;
        if (id is not null && botonesConsulta.TryGetValue(id, out var boton) && boton is not null)
        {
            await boton.EnfocarAsync();
        }
    }

    private async Task OrdenProcesada(string resultado)
    {
        seleccionada = null;
        await CargarAsync();
        mensaje = resultado;
        mensajeOk = true;
    }
}
