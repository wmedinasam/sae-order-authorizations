@page "/roles"
@attribute [Authorize(Policy = "Administrador")]
@rendermode InteractiveServer
@using System.Security.Claims
@using SAEOrderAuthorizations.Web.Components.Roles
@using SAEOrderAuthorizations.Web.Services
@inject RolesService RolesSvc

<TituloPagina Texto="Roles" />

<section class="wis-container">
    <PaginaEncabezado Titulo="Roles" Subtitulo="Perfiles de acceso y empresas que puede ver cada uno.">
        <IconButton Icono="plus" Variante="agregar" Texto="Nuevo" MostrarTexto="true" OnClick="Nuevo" />
    </PaginaEncabezado>

    <div class="wis-toolbar">
        <label class="wis-check">
            <input type="checkbox" @bind="incluirInactivos" @bind:after="CargarAsync" /> Mostrar inactivos
        </label>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="@(mensajeOk ? "wis-alert-ok" : "wis-alert-error") wis-mb-5" role="@(mensajeOk ? "status" : "alert")">@mensaje</div>
    }

    <div class="wis-card wis-seccion-tabla">
        <div class="wis-tabla-wrap">
            <table class="wis-table wis-table--cards">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Administrador</th>
                        <th>Estado</th>
                        <th class="wis-num">Empresas</th>
                        <th><span class="wis-sr-only">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in roles)
                    {
                        <tr>
                            <td data-label="Nombre">@r.Nombre?.Trim()</td>
                            <td data-label="Descripción">@r.Descripcion?.Trim()</td>
                            <td data-label="Administrador">@(r.EsAdministrador ? "Sí" : "No")</td>
                            <td data-label="Estado"><EstadoBadge Tipo="@(r.Estado ? "activo" : "inactivo")" Texto="@(r.Estado ? "Activo" : "Inactivo")" /></td>
                            <td data-label="Empresas" class="wis-num">@r.NumEmpresas</td>
                            <td>
                                <div class="wis-acciones">
                                <IconButton Icono="pencil" Variante="editar" Texto="Editar" OnClick="() => Editar(r)" />
                                @if (r.Estado)
                                {
                                    <IconButton Icono="ban" Variante="inactivar" Texto="Inactivar" OnClick="() => AlternarEstadoAsync(r)" />
                                }
                                else
                                {
                                    <IconButton Icono="undo" Variante="reactivar" Texto="Reactivar" OnClick="() => AlternarEstadoAsync(r)" />
                                }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (roles.Count == 0 && string.IsNullOrEmpty(mensaje))
                    {
                        <EstadoVacio Columnas="6" Mensaje="No hay roles para mostrar." />
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@if (mostrarModal)
{
    <RolModal Rol="rolEditando" OnCerrar="Cerrar" OnGuardado="Guardado" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ClaimsPrincipal? usuario;
    private List<RolFila> roles = new();
    private bool incluirInactivos;
    private string? mensaje;
    private bool mensajeOk;
    private bool mostrarModal;
    private RolFila? rolEditando;

    protected override async Task OnInitializedAsync()
    {
        usuario = AuthState is null ? null : (await AuthState).User;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        if (usuario is null) return;
        try
        {
            roles = await RolesSvc.ListarAsync(usuario, incluirInactivos);
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudieron cargar los roles: {ex.Message}";
            mensajeOk = false;
        }
    }

    private void Nuevo()
    {
        mensaje = null;
        mensajeOk = false;
        rolEditando = null;
        mostrarModal = true;
    }

    private void Editar(RolFila rol)
    {
        mensaje = null;
        mensajeOk = false;
        rolEditando = rol;
        mostrarModal = true;
    }

    private void Cerrar() => mostrarModal = false;

    private async Task Guardado(string resultado)
    {
        mostrarModal = false;
        await CargarAsync();
        mensaje = resultado;
        mensajeOk = true;
    }

    private async Task AlternarEstadoAsync(RolFila rol)
    {
        if (usuario is null) return;
        var resultado = await RolesSvc.CambiarEstadoAsync(usuario, rol.Id, !rol.Estado);
        await CargarAsync();
        mensaje = resultado.Mensaje;
        mensajeOk = resultado.Exito;
    }
}
