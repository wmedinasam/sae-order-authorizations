@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SAEOrderAuthorizations.Web.Data.Entities
@using SAEOrderAuthorizations.Web.Services
@inject OrdenesService OrdenesSvc
@inject OrdenesMonitor Monitor
@implements IDisposable

<TituloPagina Texto="Inicio" />

<section class="wis-container">
    <PaginaEncabezado Titulo="@($"Hola, {nombre}")" Subtitulo="Resumen de órdenes de compra por empresa.">
        <a class="wis-button" href="/ordenes">Ver órdenes pendientes</a>
    </PaginaEncabezado>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="wis-alert-error wis-mb-5" role="alert">@error</div>
    }
    @if (actualizado is not null)
    {
        <p class="wis-muted wis-mb-5" aria-live="polite">Actualizado a las @actualizado.Value.ToString("HH:mm:ss")</p>
    }

    <div class="wis-seccion">
        @foreach (var r in resumenes)
        {
            <div class="wis-card wis-stack">
                <h2 class="wis-h3">@r.Empresa.Nombre?.Trim()</h2>
                @if (r.Error is not null)
                {
                    <div class="wis-alert-error" role="alert">@r.Error</div>
                }
                else
                {
                    <div class="wis-stats">
                        <a class="wis-stat wis-stat--pendiente" href="/ordenes">
                            <span class="wis-stat-num">@r.Pendientes</span>
                            <span class="wis-stat-label">Pendientes</span>
                        </a>
                        <div class="wis-stat wis-stat--autorizada">
                            <span class="wis-stat-num">@r.Autorizadas</span>
                            <span class="wis-stat-label">Autorizadas</span>
                        </div>
                        <div class="wis-stat wis-stat--rechazada">
                            <span class="wis-stat-num">@r.Rechazadas</span>
                            <span class="wis-stat-label">Rechazadas</span>
                        </div>
                    </div>
                }
            </div>
        }
        @if (resumenes.Count == 0 && string.IsNullOrEmpty(error))
        {
            <div class="wis-card"><p class="wis-muted wis-flush">Tu rol no tiene empresas asignadas.</p></div>
        }
    </div>
</section>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string nombre = string.Empty;
    private string? error;
    private DateTime? actualizado;
    private int rolId;
    private readonly List<Resumen> resumenes = new();

    private sealed record Resumen(Empresa Empresa, int Pendientes, int Autorizadas, int Rechazadas, string? Error);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var usuario = (await AuthState).User;
        nombre = usuario.Identity?.Name ?? string.Empty;
        int.TryParse(usuario.FindFirst("RolId")?.Value, out rolId);

        Monitor.Refrescar += AlRefrescar;
        await CargarAsync();
    }

    public void Dispose() => Monitor.Refrescar -= AlRefrescar;

    // Llega desde el monitor (otro hilo): se vuelve al circuito con InvokeAsync.
    private Task AlRefrescar() => InvokeAsync(async () =>
    {
        await CargarAsync();
        StateHasChanged();
    });

    // Arma la lista completa antes de reemplazar la anterior: la pantalla nunca se ve a medio cargar.
    private async Task CargarAsync()
    {
        var nuevos = new List<Resumen>();
        try
        {
            foreach (var e in await OrdenesSvc.EmpresasDelRolAsync(rolId))
            {
                try
                {
                    var p = await OrdenesSvc.ContarAsync(e, "P");
                    var o = await OrdenesSvc.ContarAsync(e, "O");
                    var r = await OrdenesSvc.ContarAsync(e, "R");
                    nuevos.Add(new Resumen(e, p, o, r, null));
                }
                catch (Exception ex)
                {
                    nuevos.Add(new Resumen(e, 0, 0, 0, $"No se pudieron leer las órdenes: {ex.Message}"));
                }
            }
            error = null;
        }
        catch (Exception ex)
        {
            error = $"No se pudo cargar el resumen: {ex.Message}";
        }
        resumenes.Clear();
        resumenes.AddRange(nuevos);
        actualizado = DateTime.Now;
    }
}
