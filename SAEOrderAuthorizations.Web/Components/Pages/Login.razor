@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SAEOrderAuthorizations.Web.Data
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpAccessor

<PageTitle>Iniciar sesión</PageTitle>

<h1>Iniciar sesión</h1>

<EditForm Model="model" OnValidSubmit="Ingresar" FormName="login" class="col-md-4">
    <div class="mb-3">
        <label class="form-label" for="usuario">Usuario</label>
        <InputText id="usuario" class="form-control" @bind-Value="model.Nick" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" />
    </div>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-danger">@mensaje</div>
    }
    <button type="submit" class="btn btn-primary">Ingresar</button>
</EditForm>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromForm] private LoginModel model { get; set; } = new();
    private string? mensaje;

    private async Task Ingresar()
    {
        mensaje = null;
        // Contraseña en claro por ahora (decisión temporal; ver CLAUDE.md).
        var usuario = await (from u in Db.Usuarios
                             join r in Db.Roles on u.RolId equals r.Id
                             where u.NickName == model.Nick && u.Password == model.Password && r.Estado == true
                             select new { u, r }).FirstOrDefaultAsync();

        if (usuario is null)
        {
            mensaje = "Usuario/contraseña incorrecto";
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, usuario.u.Id.ToString()),
            new(ClaimTypes.Name, usuario.u.FullName ?? usuario.u.NickName ?? string.Empty),
            new("Nick", usuario.u.NickName ?? string.Empty),
            new("RolId", usuario.r.Id.ToString()),
            new(ClaimTypes.Role, usuario.r.Nombre ?? string.Empty),
            new("EsAdministrador", (usuario.r.EsAdministrador ?? false).ToString())
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpAccessor.HttpContext!.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        var destino = !string.IsNullOrEmpty(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative) ? ReturnUrl : "/";
        Navigation.NavigateTo(destino, forceLoad: true);
    }

    public class LoginModel
    {
        public string Nick { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
