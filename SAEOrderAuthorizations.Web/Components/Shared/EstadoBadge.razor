@* Estado con color semántico y texto (nunca solo color). Tipo: activo, inactivo, pendiente, autorizada, rechazada. *@
<span class="wis-badge wis-badge--@Tipo">@Texto</span>

@code {
    [Parameter, EditorRequired] public string Texto { get; set; } = string.Empty;
    [Parameter] public string Tipo { get; set; } = "activo";
}
