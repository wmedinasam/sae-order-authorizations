@* Ícono SVG inline (trazo, 24x24). Decorativo: el nombre accesible lo da el elemento que lo contiene. *@
<svg viewBox="0 0 24 24" width="@Tamano" height="@Tamano" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Nombre)
    {
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "pencil":
            <path d="M4 20h4L19 9l-4-4L4 16v4z" />
            break;
        case "ban":
            <circle cx="12" cy="12" r="9" />
            <path d="M5.6 5.6l12.8 12.8" />
            break;
        case "undo":
            <path d="M9 14 4 9l5-5" />
            <path d="M4 9h10a6 6 0 0 1 0 12h-3" />
            break;
        case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "eye-off":
            <path d="M3 3l18 18" />
            <path d="M10.6 6.1A10 10 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.2 3.9M6.5 7.6A17 17 0 0 0 2 12s3.5 6 10 6a10 10 0 0 0 3.4-.6" />
            break;
        case "save":
            <path d="M5 3h11l3 3v15H5z" />
            <path d="M8 3v5h8V3M8 21v-7h8v7" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "check":
            <path d="M5 12l5 5 9-10" />
            break;
        case "home":
            <path d="M3 11l9-8 9 8" />
            <path d="M5 10v10h14V10" />
            break;
        case "clipboard":
            <rect x="6" y="4" width="12" height="17" rx="2" />
            <path d="M9 4h6v3H9zM9 12h6M9 16h4" />
            break;
        case "building":
            <path d="M4 21V5l8-2v18M12 8h8v13M2 21h20" />
            <path d="M7 9h2M7 13h2M7 17h2M15 12h2M15 16h2" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5" />
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h0a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5h0a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v0a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            break;
        case "logout":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;
    [Parameter] public int Tamano { get; set; } = 20;
}
