@inherits LayoutComponentBase
@using SAEOrderAuthorizations.Web.Services
@inject MarcaService MarcaService

<div class="wis-page">
    <header class="wis-logo-header">
        <img src="@_marca.LogoLoginUrl" alt="@_marca.NombreEmpresa" />
    </header>
    @Body
</div>

@code {
    private MarcaInfo _marca = null!;

    protected override async Task OnInitializedAsync() => _marca = await MarcaService.ObtenerAsync();
}
