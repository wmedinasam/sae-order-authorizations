@inherits LayoutComponentBase

<div class="wis-app">
    <input type="checkbox" id="wis-nav-toggle" class="wis-nav-toggle" aria-hidden="true" />
    <label for="wis-nav-toggle" class="wis-nav-button">Menú</label>

    <aside class="wis-sidebar">
        <NavMenu />
    </aside>

    <main class="wis-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
