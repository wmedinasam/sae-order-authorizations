@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SAEOrderAuthorizations.Web.Data.Entities
@using SAEOrderAuthorizations.Web.Components.Shared
@using SAEOrderAuthorizations.Web.Services
@inject OrdenesService Ordenes
@implements IAsyncDisposable

<WisModal Titulo="@($"Orden {IdOrden}")" OnCerrar="OnCerrar">

        @if (cabecera is not null)
        {
            <dl class="wis-cabecera">
                <div><dt>Proveedor</dt><dd>@cabecera.Supplier?.Trim()</dd></div>
                <div><dt>Fecha</dt><dd>@cabecera.DateOrder.ToString("d")</dd></div>
                <div><dt>Total</dt><dd>@((cabecera.Total ?? 0).ToString("N2"))</dd></div>
            </dl>
        }

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="wis-alert-error" role="alert">@mensaje</div>
        }
        @if (puedeProcesar && !reservaMia && reservadaPor is not null)
        {
            <div class="wis-alert-error" role="status">En revisión por @reservadaPor. Solo puedes consultarla.</div>
        }

        <div class="wis-tabs" role="tablist" aria-label="Detalle de la orden" @onkeydown="TeclaPestana">
            <button type="button" role="tab" id="tab-partidas" aria-controls="panel-orden" aria-selected="@(pestana == "partidas" ? "true" : "false")"
                    tabindex="@(pestana == "partidas" ? 0 : -1)" class="wis-tab @(pestana == "partidas" ? "activa" : "")" @onclick='() => pestana = "partidas"'>Partidas</button>
            <button type="button" role="tab" id="tab-historial" aria-controls="panel-orden" aria-selected="@(pestana == "historial" ? "true" : "false")"
                    tabindex="@(pestana == "historial" ? 0 : -1)" class="wis-tab @(pestana == "historial" ? "activa" : "")" @onclick='() => pestana = "historial"'>Historial</button>
        </div>

        <div role="tabpanel" id="panel-orden" aria-labelledby="tab-@pestana">

        @if (pestana == "partidas")
        {
            <div class="wis-tabla-wrap">
                <table class="wis-table wis-table--fija">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th class="wis-num">Cantidad</th>
                            <th class="wis-num">Precio</th>
                            <th class="wis-num">IVA</th>
                            <th class="wis-num">Descuento</th>
                            <th class="wis-num">Total partida</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in partidas)
                        {
                            <tr>
                                <td>@p.IdProd?.Trim()</td>
                                <td>@p.Description?.Trim()</td>
                                <td class="wis-num">@((p.Quantity ?? 0).ToString("N2"))</td>
                                <td class="wis-num">@((p.Price ?? 0).ToString("N2"))</td>
                                <td class="wis-num">@((p.VAT ?? 0).ToString("N2"))</td>
                                <td class="wis-num">@((p.Discount ?? 0).ToString("N2"))</td>
                                <td class="wis-num">@((p.TotalItem ?? 0).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @if (historial.Count == 0)
            {
                <p class="wis-muted">Sin movimientos registrados.</p>
            }
            <ul class="wis-historial">
                @foreach (var h in historial)
                {
                    <li>
                        <span class="wis-muted">@h.Fecha.ToString("g") · @h.Usuario</span>
                        <div>@h.Descripcion</div>
                    </li>
                }
            </ul>
        }
        </div>

        @if (puedeProcesar && reservaMia)
        {
            <div class="wis-accion wis-modal-acciones-fijas">
                <label class="wis-field-label" for="comentario">Comentario (obligatorio para rechazar, máx. 150)</label>
                <textarea id="comentario" class="wis-input" rows="2" maxlength="150" @bind="comentario"></textarea>
                <div class="wis-form-acciones">
                    <IconButton Icono="check" Variante="autorizar" Texto="Autorizar" MostrarTexto="true" Solido="true" Deshabilitado="@procesando" OnClick="Autorizar" />
                    <IconButton Icono="x" Variante="rechazar" Texto="Rechazar" MostrarTexto="true" Solido="true" Deshabilitado="@procesando" OnClick="Rechazar" />
                </div>
            </div>
        }
</WisModal>

@code {
    [Parameter, EditorRequired] public OrdenSae Orden { get; set; } = default!;
    [Parameter, EditorRequired] public Empresa Empresa { get; set; } = default!;
    [Parameter] public bool EsAprobador { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback<string> OnProcesada { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ClaimsPrincipal? usuario;
    private Services.OrdenCabeceraSae? cabecera;
    private List<OrdenPartidaSae> partidas = new();
    private List<HistorialEntrada> historial = new();
    private string pestana = "partidas";
    private string comentario = string.Empty;
    private string? mensaje;
    private bool procesando;
    private bool reservaMia;
    private string? reservadaPor;
    private System.Threading.Timer? latido;
    private bool cerrada;

    private string IdOrden => Orden.IdOrder.Trim();

    // Latido de la reserva: mientras el modal esté abierto, nadie más puede procesar la orden.
    private static readonly TimeSpan IntervaloLatido = TimeSpan.FromMinutes(1);

    private void TeclaPestana(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowRight" or "ArrowLeft") pestana = pestana == "partidas" ? "historial" : "partidas";
    }

    private bool puedeProcesar => EsAprobador && Orden.Status == "P";

    protected override async Task OnInitializedAsync()
    {
        usuario = AuthState is null ? null : (await AuthState).User;
        try
        {
            if (puedeProcesar && usuario is not null)
            {
                var reserva = await Ordenes.ReservarAsync(usuario, Empresa, IdOrden);
                reservaMia = reserva.Exito;
                reservadaPor = reserva.ReservadaPor;
                if (reservaMia)
                    latido = new System.Threading.Timer(_ => _ = InvokeAsync(LatidoAsync), null, IntervaloLatido, IntervaloLatido);
            }

            var (cab, partidasSae) = await Ordenes.DetalleAsync(Empresa, IdOrden);
            cabecera = cab;
            partidas = partidasSae;
            historial = await Ordenes.HistorialAsync(Empresa, IdOrden);
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo cargar el detalle: {ex.Message}";
        }
    }

    private async Task LatidoAsync()
    {
        if (cerrada || usuario is null) return;
        var reserva = await Ordenes.ReservarAsync(usuario, Empresa, IdOrden);
        if (reserva.Exito) return;

        // Si la reserva se perdió (p. ej. el circuito estuvo caído más de 5 min), se deja de renovar.
        reservaMia = false;
        reservadaPor = reserva.ReservadaPor;
        latido?.Dispose();
        latido = null;
        mensaje = "Perdiste la reserva de esta orden. Ciérrala y vuelve a abrirla.";
        // Fuera de un evento de usuario Blazor no re-renderiza solo.
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Al cerrar el modal se libera la orden para el siguiente aprobador. Si el circuito murió, expira sola.
        cerrada = true;
        if (latido is not null) await latido.DisposeAsync();
        if (reservaMia && usuario is not null)
            await Ordenes.LiberarAsync(usuario, Empresa, IdOrden);
    }

    private async Task Autorizar() => await Procesar(true);

    private async Task Rechazar() => await Procesar(false);

    private async Task Procesar(bool aprobar)
    {
        if (usuario is null) return;
        procesando = true;
        mensaje = null;
        try
        {
            var resultado = await Ordenes.ProcesarAsync(usuario, Empresa, IdOrden, aprobar, comentario);
            if (resultado.Exito)
            {
                await OnProcesada.InvokeAsync(resultado.Mensaje);
            }
            else
            {
                mensaje = resultado.Mensaje;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo procesar la orden: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}
