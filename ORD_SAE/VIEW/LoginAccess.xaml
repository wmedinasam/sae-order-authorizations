<Window x:Class="ORD_SAE.VIEW.LoginAccess"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORD_SAE.VIEW"
        mc:Ignorable="d"
        Title="Inicio de Sesion" Height="360" Width="510" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Century Gothic" FontSize="22" Icon="/ORD_SAE;component/PICTURES/box.png" Loaded="Window_Loaded">
    <Grid>
        <Label x:Name="lblInicio" Content="Iniciar Sesion" Margin="173,10,174,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Image x:Name="image" HorizontalAlignment="Left" Height="194" Margin="298,112,0,0" VerticalAlignment="Top" Width="196" Source="/ORD_SAE;component/PICTURES/inicio.png" Opacity="0.1"/>
        <Label x:Name="lblUsuario" Content="Usuario" Margin="208,52,208,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtUsuario" Height="30" Margin="161,94,161,0" TextWrapping="Wrap" VerticalAlignment="Top" Background="{x:Null}" BorderThickness="0,0,0,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Label x:Name="lblPass" Content="Contraseña" Margin="183,129,183,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="pwPassword" Height="30" Margin="161,171,161,0" VerticalAlignment="Top" Background="{x:Null}" BorderThickness="0,0,0,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Button x:Name="btnIniciar" HorizontalAlignment="Left" Margin="161,206,0,0" VerticalAlignment="Top" Width="80" Height="80" Background="{x:Null}" BorderBrush="{x:Null}" Click="BtnIniciar_Click">
            <Image x:Name="imgIniciar" Height="70" Width="70" Source="/ORD_SAE;component/PICTURES/user.png"/>
        </Button>
        <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="263,206,0,0" VerticalAlignment="Top" Width="80" Height="80" Background="{x:Null}" BorderBrush="{x:Null}" Click="BtnCancelar_Click">
            <Image x:Name="imgCancelar" Height="70" Width="70" Source="/ORD_SAE;component/PICTURES/enter.png"/>
        </Button>
        <Label x:Name="lblIniciar" Content="Iniciar" HorizontalAlignment="Left" Margin="165,288,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label x:Name="lblSalir" Content="Salir" HorizontalAlignment="Left" Margin="293,288,0,0" VerticalAlignment="Top" FontSize="14"/>
    </Grid>
</Window>
