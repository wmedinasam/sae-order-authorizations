<Window x:Class="ORD_SAE.VIEW.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORD_SAE.VIEW"
        mc:Ignorable="d"
        Title="Configuracion" Height="594.5" Width="800" FontFamily="Microsoft JhengHei" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="/ORD_SAE;component/PICTURES/box.png">
    <Grid>
        <Image x:Name="imgBitacora" HorizontalAlignment="Left" Height="100" Margin="684,10,0,0" VerticalAlignment="Top" Width="100" Source="/ORD_SAE;component/PICTURES/settings.png" Opacity="0.2"/>
        <Label x:Name="lblBitacora" Content="Configuraciones"  HorizontalAlignment="Left" Margin="274,10,0,0" VerticalAlignment="Top" Height="68" Width="405" FontSize="36" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Opacity="0.2"/>

        <GroupBox x:Name="gprBoxSistema" Header="Configuracion Sistema" HorizontalAlignment="Left" Margin="10,60,0,10.8" Width="381" FontFamily="Microsoft JhengHei" FontWeight="Bold" FontSize="16"/>


        <GroupBox x:Name="gprBoxSAE" Header="Configuracion SAE" HorizontalAlignment="Left" Margin="407,60,0,11" Width="367" FontFamily="Microsoft JhengHei" FontWeight="Bold" FontSize="16"/>

        <Image x:Name="image" HorizontalAlignment="Left" Height="44" Margin="292,83,0,0" VerticalAlignment="Top" Width="50" Source="/ORD_SAE;component/PICTURES/email.png"/>
        <Label x:Name="lblCorreo" Content="Correo Emisor:" HorizontalAlignment="Left" Margin="22,100,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <TextBox x:Name="txtCorreoEmisor" HorizontalAlignment="Left" Height="30" Margin="22,130,0,0" VerticalAlignment="Top" Width="340" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" FontSize="14"/>

        <Label x:Name="lblCorreoEmisorContraseña" Content="Contraseña Correo:" HorizontalAlignment="Left" Margin="22,180,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <PasswordBox x:Name="pwdCorreoEmisor" HorizontalAlignment="Left" Height="30" Margin="22,210,0,0" VerticalAlignment="Top" Width="340" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" FontSize="14"/>

        <Label x:Name="lblAsunto" Content="Asunto de Correo:" HorizontalAlignment="Left" Margin="22,245,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <TextBox x:Name="txtAsunto" HorizontalAlignment="Left" Height="25" Margin="22,279,0,0" VerticalAlignment="Top" Width="340" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" FontSize="14"/>

        <Label x:Name="lblCuerpo" Content="Cuerpo del Correo:" HorizontalAlignment="Left" Margin="22,309,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <Label x:Name="lblEjemplo" Content="Ver Ejemplo" HorizontalAlignment="Left" Margin="161,309,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Width="201" FontFamily="Microsoft JhengHei" Height="29" ToolTip="Ejemplo para añadir variables:  {0} = usuario, {1} = documento, {2} = Aprobada/Rechazada, {3} = empresa"/>

        <TextBox x:Name="txtCuerpo" HorizontalAlignment="Left" Height="197" Margin="22,343,0,0" VerticalAlignment="Top" Width="340" BorderThickness="1" FontSize="14" TextWrapping="Wrap"/>



        <Image x:Name="imgUsuario" HorizontalAlignment="Left" Height="44" Margin="708,81,0,0" VerticalAlignment="Top" Width="50" Source="/ORD_SAE;component/PICTURES/man.png"/>
        <Label x:Name="lblUsuario" Content="Usuario:" HorizontalAlignment="Left" Margin="418,100,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <TextBox x:Name="txtUsuario" HorizontalAlignment="Left" Height="30" FontSize="18" Margin="418,130,0,0" VerticalAlignment="Top" Width="340" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0,0,0,1"/>

        <Label x:Name="lblContraseña" Content="Contraseña:" HorizontalAlignment="Left" Margin="418,180,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <PasswordBox x:Name="pwdContraseña" HorizontalAlignment="Left" Margin="418,210,0,0" VerticalAlignment="Top" Height="30" Width="340" BorderThickness="0,0,0,1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="14"/>

        <Image x:Name="imgSAE" Visibility="Hidden" HorizontalAlignment="Left" Height="44" Margin="708,250,0,0" VerticalAlignment="Top" Width="50" Source="/ORD_SAE;component/PICTURES/aspel-sae-70.jpg"/>
        <Label x:Name="lblBaseDatos" Visibility="Hidden" Content="Base de Datos SAE:" HorizontalAlignment="Left" Margin="418,260,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <TextBox x:Name="txtBaseDatos" Visibility="Hidden" HorizontalAlignment="Left" Height="30" Margin="418,290,0,0" VerticalAlignment="Top" Width="340" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" FontSize="14"/>

        <Image x:Name="imgKey" HorizontalAlignment="Left" Height="44" Margin="708,250,0,0" VerticalAlignment="Top" Width="50" Source="/ORD_SAE;component/PICTURES/key.png"/>
        <Label x:Name="lblLlave" Content="Llave de Sistema:" HorizontalAlignment="Left" Margin="418,260,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Normal"/>
        <TextBox x:Name="txtLlave" HorizontalAlignment="Left" Height="156" Margin="418,312,0,0" VerticalAlignment="Top" Width="340" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" FontSize="14" TextWrapping="Wrap"/>

        <Button x:Name="btnGuardarSAE" HorizontalAlignment="Left" Margin="688,0,0,25" Width="79" BorderBrush="{x:Null}" Background="{x:Null}" Click="BtnGuardarSAE_Click" Height="67" VerticalAlignment="Bottom">
            <Image x:Name="imgGuardar2" HorizontalAlignment="Left" Height="57" VerticalAlignment="Top" Width="59" Source="/ORD_SAE;component/PICTURES/save.png"/>
        </Button>
    </Grid>
</Window>
