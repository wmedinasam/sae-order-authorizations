<Window x:Class="ORD_SAE.VIEW.Bitacora"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORD_SAE.VIEW"
        mc:Ignorable="d"
        Title="Bitacora" Height="500" Width="850" FontFamily="Microsoft JhengHei" FontSize="14" FontWeight="Bold" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Icon="/ORD_SAE;component/PICTURES/box.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="105*"/>
        </Grid.RowDefinitions>
        <Image x:Name="imgBitacora" HorizontalAlignment="Right" Height="100" Margin="0,10,10.2,0" VerticalAlignment="Top" Width="100" Source="/ORD_SAE;component/PICTURES/history-clock-button.png" Opacity="0.2"/>
        <Label x:Name="lblBitacora" Content="Bitacora" Margin="0,10,115.2,0" VerticalAlignment="Top" Height="68" FontSize="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Opacity="0.2" HorizontalAlignment="Right" Width="163" FontFamily="Century Gothic" FontWeight="Normal"/>
        <Label x:Name="lblFiltrar" Content="Filtrar Bitacora:" HorizontalAlignment="Left" Margin="9,49,0,0" VerticalAlignment="Top" Width="135" FontFamily="Century Gothic" FontWeight="Normal" FontSize="16"/>
        <DatePicker x:Name="dpDesde" HorizontalAlignment="Left" Margin="74,83,0,0" VerticalAlignment="Top" FontWeight="Normal" FontFamily="Century Gothic" Width="100"/>
        <DatePicker x:Name="dpHasta"  Margin="0,83,487.2,0" VerticalAlignment="Top" FontWeight="Normal" LostFocus="DpHasta_LostFocus" HorizontalAlignment="Right" Width="100" FontFamily="Century Gothic"/>
        <Label x:Name="lblHasta" Content="Hasta:" HorizontalAlignment="Right" Margin="0,83,592.2,0" VerticalAlignment="Top" Width="54" RenderTransformOrigin="0.641,0.267" FontFamily="Century Gothic" FontWeight="Normal"/>
        <Label x:Name="lblDesde" Content="Desde:" HorizontalAlignment="Left" Margin="9,83,0,0" VerticalAlignment="Top" Width="60" FontFamily="Century Gothic" FontWeight="Normal"/>
        <DataGrid x:Name="dataGrid" IsReadOnly="True" Margin="10,120,10.2,10.4" CanUserAddRows="False" AutoGenerateColumns="False" FontFamily="Century Gothic" FontWeight="Normal" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Correlator ID" Binding="{Binding correlator_id}"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding fecha_registro, StringFormat=d}"/>
                <DataGridTextColumn Header="No. Orden" Binding="{Binding no_orden}"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding proveedor}"/>
                <DataGridTextColumn Header="Descripcion" Binding="{Binding descripcion}"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding usuario}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="btnFiltrar" Content="Filtrar" Margin="0,81,10,0" VerticalAlignment="Top" Height="27" Background="#FFE1ECFC" Click="BtnFiltrar_Click" HorizontalAlignment="Right" Width="65" FontFamily="Century Gothic" FontWeight="Normal"/>
        <Label x:Name="lblBuscar" Content="Buscar:" HorizontalAlignment="Right" Margin="0,83,330,0" VerticalAlignment="Top" Width="60" FontFamily="Century Gothic" FontWeight="Normal" RenderTransformOrigin="0.493,0.485"/>
        <TextBox x:Name="txtBuscar" Height="27" Margin="0,83,86,0" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Normal" BorderThickness="0,0,0,1" Background="{x:Null}" HorizontalAlignment="Right" Width="239" FontFamily="Century Gothic"/>
        <Button x:Name="btnVerTodo" Content="Ver Todo" Margin="0,83,395,0" VerticalAlignment="Top" Height="27" Background="#FFE1ECFC" Click="BtnVerTodo_Click" HorizontalAlignment="Right" Width="65" FontFamily="Century Gothic" FontWeight="Normal"/>

    </Grid>
</Window>
