<Window x:Class="ORD_SAE.VIEW.Autorizaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORD_SAE.VIEW"
        mc:Ignorable="d"
        Title="Autorizaciones" Height="650" Width="850"  WindowStartupLocation="CenterScreen" FontFamily="Microsoft JhengHei" FontSize="14" FontWeight="Bold" Loaded="Window_Loaded" Icon="/ORD_SAE;component/PICTURES/box.png">
    <Grid>
        <Image x:Name="imgAutorizacion" HorizontalAlignment="Right" Height="100" Margin="0,10,14,0" VerticalAlignment="Top" Width="100" Source="/ORD_SAE;component/PICTURES/check-list.png" Opacity="0.2"/>
        <Label x:Name="lblAutorizacion" Content="Autorizaciones"  HorizontalAlignment="Right" Margin="0,10,119,0" VerticalAlignment="Top" Height="68" Width="280" FontSize="36" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Opacity="0.2" FontFamily="Century Gothic" FontWeight="Normal"/>
        <Button x:Name="btnReload" Content="Recargar" Margin="0,75,136,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="75" Click="btnReload_Click"/>
        <ListView x:Name="dataGrid" Margin="10,115,10,46" FontWeight="Normal" FontFamily="Century Gothic">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Seleccionar" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5,0,0,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding IdOrder}" Header="Documento"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Vendor}" Header="Proveedor"/>
                    <GridViewColumn DisplayMemberBinding="{Binding OrdDate, StringFormat=d}" Header="Fecha"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Total, StringFormat='###,###,###,###.00'}" Header="Total"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Observations}" Header="Observaciones"/>
                    <GridViewColumn Header="Consultar" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Consultar" Click="Button_Click_2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Autorizar">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Autorizar" Click="Button_Click"  Visibility="{Binding  _bottonAutorizar}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Rechazar" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Rechazar" Click="Button_Click_1" Visibility="{Binding  _bottonRechazar}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="btnAutorizar" Foreground="#115724" Content="Autorizar" Margin="0,0,14,11" VerticalAlignment="Bottom" Height="30" Background="#D4EDDA" HorizontalAlignment="Right" Width="117" Click="btnAutorizar_Click" Visibility="Hidden"/>
        <CheckBox x:Name="chkTodas" Content="Selecionar Todas" HorizontalAlignment="Left" Margin="10,92,0,0" VerticalAlignment="Top" Checked="chkTodas_Checked" Unchecked="chkTodas_Unchecked" FontFamily="Century Gothic" FontWeight="Normal"/>
        <Label x:Name="lblMailStatus" Content="" HorizontalAlignment="Left" Margin="178,85,0,0" VerticalAlignment="Top" FontSize="10" FontWeight="Normal"/>
        <Button x:Name="btnRechazar" Foreground="#721c24" Content="Rechazar" Margin="0,0,136,10" VerticalAlignment="Bottom" Height="30" Background="#F8D7DA" HorizontalAlignment="Right" Width="117" Click="btnRechazar_Click" Visibility="Hidden"/>
        <ComboBox x:Name="cbRolEmpresas" HorizontalAlignment="Left" Margin="91,47,0,0" VerticalAlignment="Top" Width="264" SelectionChanged="cbRolEmpresas_SelectionChanged"/>
        <Label x:Name="label" Content="Empresas:" HorizontalAlignment="Left" Margin="10,43,0,0" VerticalAlignment="Top"/>


    </Grid>
</Window>
